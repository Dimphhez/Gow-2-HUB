--==================================================

CheckButton.MouseButton1Click:Connect(function()
    local Key = KeyBox.Text

    if Key == "" then
        Status.Text = "⚠ Masukkan kunci terlebih dahulu."
        Status.TextColor3 = Color3.fromRGB(255, 190, 80)
        return
    end

    Status.Text = "Memeriksa kunci..."
    Status.TextColor3 = Color3.fromRGB(190, 190, 210)

    task.wait(0.5)

    if CheckKey(Key) then
        Status.Text = "✓ Kunci diterima."
        Status.TextColor3 = Color3.fromRGB(90, 220, 140)

        -- Jalankan script utama kamu di sini.
        -- loadstring(...)()
    else
        Status.Text = "✕ Kunci tidak valid."
        Status.TextColor3 = Color3.fromRGB(255, 90, 90)
    end
end)

--==================================================
-- COPY LINK
--==================================================

CopyButton.MouseButton1Click:Connect(function()

    -- Untuk environment yang menyediakan setclipboard.
    if setclipboard then
        setclipboard(KEY_URL:gsub("^%[", ""):gsub("%]$", ""))

        Status.Text = "✓ Tautan berhasil disalin."
        Status.TextColor3 = Color3.fromRGB(90, 220, 140)
    else
        Status.Text = "Salin tautan ini: " .. KEY_URL
        Status.TextColor3 = Color3.fromRGB(255, 190, 80)
    end
end)

--==================================================
-- DRAG WINDOW
--==================================================

local Dragging = false
local DragStart
local StartPosition

Title.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
        Dragging = true
        DragStart = Input.Position
        StartPosition = Main.Position

        Input.Changed:Connect(function()
            if Input.UserInputState == Enum.UserInputState.End then
                Dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(Input)
    if Dragging and Input.UserInputType == Enum.UserInputType.MouseMovement then

        local Delta = Input.Position - DragStart

        Main.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + Delta.X,
            StartPosition.Y.Scale,
            StartPosition.Y.Offset + Delta.Y
        )
    end
end)
