--==================================================
-- BUTTON FUNCTION
--==================================================

local function CreateButton(text, position)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.fromOffset(205, 48)
    Button.Position = position
    Button.BackgroundColor3 = Color3.fromRGB(35, 35, 47)
    Button.BorderSizePixel = 0
    Button.Text = text
    Button.TextColor3 = Color3.fromRGB(245, 245, 250)
    Button.TextSize = 14
    Button.Font = Enum.Font.GothamBold
    Button.AutoButtonColor = false
    Button.Parent = Main

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 10)
    ButtonCorner.Parent = Button

    local ButtonStroke = Instance.new("UIStroke")
    ButtonStroke.Color = Color3.fromRGB(70, 70, 90)
    ButtonStroke.Transparency = 0.35
    ButtonStroke.Parent = Button

    Button.MouseEnter:Connect(function()
        Button.BackgroundColor3 = Color3.fromRGB(50, 50, 66)
    end)

    Button.MouseLeave:Connect(function()
        Button.BackgroundColor3 = Color3.fromRGB(35, 35, 47)
    end)

    return Button
end

